generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt         @id @default(autoincrement())
  nickname        String         @unique @db.VarChar(32)
  email           String         @unique @db.VarChar(255)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?      @map("email_verified_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  tasks           Task[]
  goals           Goal[]
  processItems    ProcessItem[]
  workSessions    TaskWorkSession[]
  dailyEarnings   DailyEarning[]
  sidebarState    SidebarState?
  notesState      NotesState?
  planState       PlanState?
  userPreference  UserPreference?
  capitalAssets   CapitalAsset[]
  capitalLocations CapitalLocation[]
  capitalNetworks CapitalNetwork[]
  capitalOperations CapitalOperation[]
  capitalAuditEvents CapitalAuditEvent[]
  capitalSyncSources CapitalSyncSource[]
  capitalSyncRuns CapitalSyncRun[]
  capitalExternalRecords CapitalExternalRecord[]
  capitalSettings CapitalSetting[]

  @@map("users")
}

model SidebarState {
  userId            BigInt   @id @map("user_id")
  stories           Json     @default("[]")
  boards            Json     @default("{}")
  deletedStoryKeys  Json     @default("{}") @map("deleted_story_keys")
  deletedSectionIds Json     @default("{}") @map("deleted_section_ids")
  deletedCardIds    Json     @default("{}") @map("deleted_card_ids")
  sidebarWidth      Int      @default(240) @map("sidebar_width")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sidebar_states")
}

model NotesState {
  userId         BigInt   @id @map("user_id")
  notes          Json     @default("[]")
  deletedNoteIds Json     @default("{}") @map("deleted_note_ids")
  sidebarWidth   Int      @default(240) @map("sidebar_width")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes_states")
}

model PlanState {
  userId            BigInt   @id @map("user_id")
  elements          Json     @default("[]")
  deletedElementIds Json     @default("{}") @map("deleted_element_ids")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_states")
}

model UserPreference {
  userId    BigInt   @id @map("user_id")
  navOrder  Json     @default("[]") @map("nav_order")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Task {
  id                 String   @id @db.VarChar(64)
  userId             BigInt   @map("user_id")
  title              String   @db.VarChar(255)
  columnId           String   @map("column_id") @db.VarChar(32)
  dateKey            String   @map("date_key") @db.VarChar(10)
  recurrenceParentId String?  @map("recurrence_parent_id") @db.VarChar(64)
  recurrence         String   @db.VarChar(16)
  completed          Boolean  @default(false)
  completedAt        DateTime? @map("completed_at")
  completionFocusMs  Int?      @map("completion_focus_ms")
  createdAtMs        BigInt   @map("created_at_ms")
  actualSeconds      Int      @default(0) @map("actual_seconds")
  sessionSeconds     Int      @default(0) @map("session_seconds")
  sessionStartedAtMs BigInt?  @map("session_started_at_ms")
  doneWhen           String   @default("") @map("done_when") @db.VarChar(500)
  workSummary        String   @default("") @map("work_summary") @db.VarChar(4000)
  parentTaskId       String?  @map("parent_task_id") @db.VarChar(64)
  isContainer        Boolean  @default(false) @map("is_container")
  focusSpentMs       Int      @default(0) @map("focus_spent_ms")
  focusHeartbeatAt   DateTime? @map("focus_heartbeat_at")
  parentTask         Task?    @relation("TaskTree", fields: [parentTaskId], references: [id], onDelete: Restrict)
  childTasks         Task[]   @relation("TaskTree")
  workSessions       TaskWorkSession[]
  subtasks           Json     @default("[]")
  priorityGroup      Int?     @map("priority_group")
  priorityRank       Float    @default(0) @map("priority_rank")
  priorityImportance Int      @default(0) @map("priority_importance")
  priorityUrgency    Int      @default(0) @map("priority_urgency")
  priorityOverdue    Int      @default(0) @map("priority_overdue")
  deletedAt          DateTime? @map("deleted_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, parentTaskId])
  @@index([userId, dateKey])
  @@index([userId, recurrenceParentId])
  @@index([userId, completed, priorityGroup, priorityRank])
  @@index([userId, deletedAt])
  @@index([userId, completedAt])
  @@map("tasks")
}

model Goal {
  id                 String    @id @db.VarChar(64)
  userId             BigInt    @map("user_id")
  title              String    @db.VarChar(255)
  completed          Boolean   @default(false)
  completedAt        DateTime? @map("completed_at")
  createdAtMs        BigInt    @map("created_at_ms")
  priorityGroup      Int?      @map("priority_group")
  priorityRank       Float     @default(0) @map("priority_rank")
  priorityImportance Int       @default(0) @map("priority_importance")
  priorityUrgency    Int       @default(0) @map("priority_urgency")
  priorityOverdue    Int       @default(0) @map("priority_overdue")
  deletedAt          DateTime? @map("deleted_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, priorityGroup, priorityRank])
  @@index([userId, deletedAt])
  @@map("goals")
}

model ProcessItem {
  id        String    @id @db.VarChar(64)
  userId    BigInt    @map("user_id")
  title     String    @db.VarChar(255)
  rank      Float     @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, rank])
  @@map("process_items")
}

model DailyEarning {
  id          String   @id @db.VarChar(64)
  userId      BigInt   @map("user_id")
  dateKey     String   @map("date_key") @db.VarChar(10)
  projectName String   @map("project_name") @db.VarChar(120)
  amountCents Int      @default(0) @map("amount_cents")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateKey])
  @@map("daily_earnings")
}

// A checkpoint credits only confirmed active intervals. Expired leases never accrue time.
model TaskWorkSession {
  id           String   @id @db.Uuid
  userId       BigInt   @map("user_id")
  taskId       String   @map("task_id") @db.VarChar(64)
  startedAt    DateTime @default(now()) @map("started_at")
  checkpointAt DateTime @default(now()) @map("checkpoint_at")
  sequence     Int      @default(0)
  creditedMs   Int      @default(0) @map("credited_ms")
  endedAt      DateTime? @map("ended_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([userId, endedAt])
  @@index([taskId])
  @@map("task_work_sessions")
}

// Capital keeps owner in both primary and foreign keys, including restored IDs.
model CapitalAsset {
  userId BigInt @map("user_id")
  id String
  symbol String
  name String
  kind String
  decimals Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  legs CapitalLeg[]
  @@id([userId, id])
  @@map("capital_assets")
}
model CapitalLocation {
  userId BigInt @map("user_id")
  id String
  name String
  kind String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoing CapitalOperation[] @relation("CapitalFrom")
  incoming CapitalOperation[] @relation("CapitalTo")
  legs CapitalLeg[]
  @@id([userId, id])
  @@map("capital_locations")
}
model CapitalNetwork {
  userId BigInt @map("user_id")
  id String
  name String
  code String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations CapitalOperation[]
  @@id([userId, id])
  @@map("capital_networks")
}
model CapitalOperation {
  userId BigInt @map("user_id")
  id String @default(uuid())
  type String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  timezone String
  status String
  source String
  externalId String? @map("external_id")
  externalRevision String? @map("external_revision")
  importKey String? @map("import_key")
  chainKey String? @map("chain_key")
  locationFromId String? @map("location_from_id")
  locationToId String? @map("location_to_id")
  networkId String? @map("network_id")
  txHash String? @map("tx_hash")
  logIndex Int? @map("log_index")
  destinationAddress String? @map("destination_address")
  note String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationFrom CapitalLocation? @relation("CapitalFrom", fields: [userId, locationFromId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  locationTo CapitalLocation? @relation("CapitalTo", fields: [userId, locationToId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  network CapitalNetwork? @relation(fields: [userId, networkId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  legs CapitalLeg[]
  auditEvents CapitalAuditEvent[]
  @@id([userId, id])
  @@unique([userId, importKey])
  @@unique([userId, chainKey])
  @@index([userId, occurredAt, createdAt])
  @@index([userId, status])
  @@map("capital_operations")
}
model CapitalLeg {
  userId BigInt @map("user_id")
  id String @default(uuid())
  operationId String @map("operation_id")
  direction String
  assetId String @map("asset_id")
  locationId String? @map("location_id")
  amount Decimal @db.Decimal(38,18)
  fiatValue Decimal? @map("fiat_value") @db.Decimal(38,8)
  unitPrice Decimal? @map("unit_price") @db.Decimal(38,18)
  position Int
  operation CapitalOperation @relation(fields: [userId, operationId], references: [userId, id], onDelete: Cascade)
  asset CapitalAsset @relation(fields: [userId, assetId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  location CapitalLocation? @relation(fields: [userId, locationId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, id])
  @@unique([userId, operationId, position])
  @@index([userId, assetId])
  @@map("capital_legs")
}
model CapitalAuditEvent {
  userId BigInt @map("user_id")
  id String @default(uuid())
  operationId String? @map("operation_id")
  action String
  payload Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation CapitalOperation? @relation(fields: [userId, operationId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, id])
  @@index([userId, operationId, createdAt])
  @@map("capital_audit_events")
}
model CapitalSyncSource {
  userId BigInt @map("user_id")
  id String
  displayName String @map("display_name")
  enabled Boolean @default(true)
  cursor String?
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, id])
  @@map("capital_sync_sources")
}
model CapitalSyncRun {
  userId BigInt @map("user_id")
  id String @default(uuid())
  source String
  status String
  cursor String?
  importedCount Int @default(0) @map("imported_count")
  error String?
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  heartbeatAt DateTime @default(now()) @map("heartbeat_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, id])
  @@index([userId, source, startedAt])
  @@map("capital_sync_runs")
}
model CapitalExternalRecord {
  userId BigInt @map("user_id")
  id String @default(uuid())
  source String
  externalId String @map("external_id")
  revision String?
  kind String
  payload Json
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, id])
  @@unique([userId, source, externalId])
  @@map("capital_external_records")
}
model CapitalSetting {
  userId BigInt @map("user_id")
  key String
  value Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, key])
  @@map("capital_settings")
}
