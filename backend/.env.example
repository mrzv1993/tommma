# `start` overrides only the local web/API listeners through MDEV_*_PORT.
PORT=8787
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
DATABASE_URL=postgresql://mxrxzxw@127.0.0.1:5432/tommma?schema=public
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Capital: server-only read-only OKX credentials, always bound to a Tommma user ID.
# Prefer an absolute path to a private JSON file (chmod 600); see docs/capital/README.md.
CAPITAL_CONNECTIONS_FILE=
# Single-owner fallback; ignored when CAPITAL_CONNECTIONS_FILE is set.
CAPITAL_OKX_OWNER_USER_ID=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_PASSPHRASE=
OKX_WALLET_ADDRESS=
OKX_WEB3_CHAIN_IDS=1,42161,10,8453,56,137
